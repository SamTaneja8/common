logging {
  level  = "info"
  format = "logfmt"
}

prometheus.remote_write "grafana_cloud" {
  external_labels = {
    host        = sys.env("COMMON_HOST_LABEL"),
    source_repo = "common",
  }

  endpoint {
    url = sys.env("GCLOUD_HOSTED_METRICS_URL")

    basic_auth {
      username = sys.env("GCLOUD_HOSTED_METRICS_ID")
      password = sys.env("GCLOUD_RW_API_KEY")
    }
  }
}

prometheus.exporter.unix "host" {
  include_exporter_metrics = false
  disable_collectors       = ["ipvs"]
}

prometheus.scrape "host" {
  job_name        = "node"
  targets         = prometheus.exporter.unix.host.targets
  scrape_interval = sys.env("GCLOUD_SCRAPE_INTERVAL")
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.exporter.cadvisor "docker" {
  docker_host = "unix:///var/run/docker.sock"

  allowlisted_container_labels = [
    "com.docker.compose.project",
    "com.docker.compose.service",
  ]
}

prometheus.scrape "docker" {
  job_name        = "cadvisor"
  targets         = prometheus.exporter.cadvisor.docker.targets
  scrape_interval = sys.env("GCLOUD_SCRAPE_INTERVAL")
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.exporter.self "alloy" {}

prometheus.scrape "alloy" {
  job_name        = "alloy"
  targets         = prometheus.exporter.self.alloy.targets
  scrape_interval = sys.env("GCLOUD_SCRAPE_INTERVAL")
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

loki.source.file "scraper_logs" {
  targets = [
    {
      __path__ = "/home/botuser/*/logs/*.log",
      host     = sys.env("COMMON_HOST_LABEL"),
      stream   = "app",
    },
    {
      __path__ = "/home/botuser/*/logs/container_runs/*.log",
      host     = sys.env("COMMON_HOST_LABEL"),
      stream   = "container",
    },
    {
      __path__ = "/home/botuser/*/logs/cron_runs/*.log",
      host     = sys.env("COMMON_HOST_LABEL"),
      stream   = "cron",
    },
    {
      __path__ = "/home/botuser/*/logs/service_runs/*.log",
      host     = sys.env("COMMON_HOST_LABEL"),
      stream   = "service",
    },
  ]

  forward_to = [loki.process.add_repo_label.receiver]

  file_match {
    enabled     = true
    sync_period = "10s"
  }
}

loki.process "add_repo_label" {
  forward_to = [loki.write.grafana_cloud.receiver]

  stage.regex {
    source     = "filename"
    expression = "/home/botuser/(?P<repo>[^/]+)/logs/"
  }

  stage.labels {
    values = {
      repo = "repo",
    }
  }

  stage.regex {
    expression = "(?P<level>DEBUG|INFO|WARNING|ERROR|CRITICAL)"
  }

  stage.regex {
    expression = "\\[run=(?P<run_uuid>[^\\]]+)\\]"
  }

  stage.regex {
    expression = "\\[pipeline_run=(?P<pipeline_run_id>[^\\]]+)\\]"
  }

  stage.regex {
    expression = "(?:^|\\s)job(?:_name)?=(?P<job_name>[^\\s]+)"
  }

  stage.regex {
    expression = "(?:^|\\s)step(?:_name)?=(?P<step_name>[^\\s]+)"
  }

  stage.regex {
    expression = "(?:^|\\s)stage=(?P<deal_stage>[^\\s]+)"
  }

  stage.regex {
    expression = "(?:^|\\s)status=(?P<deal_status>[^\\s]+)"
  }

  stage.regex {
    expression = "(?:^|\\s)content_id=(?P<content_id>[^\\s]+)"
  }

  stage.regex {
    expression = "(?:^|\\s)asin=(?P<asin>[^\\s]+)"
  }

  stage.regex {
    expression = "(?:^|\\s)review_queue_id=(?P<review_queue_id>[^\\s]+)"
  }

  stage.labels {
    values = {
      level       = "level",
      job_name    = "job_name",
      deal_stage  = "deal_stage",
      deal_status = "deal_status",
    }
  }

  stage.structured_metadata {
    values = {
      run_uuid        = "run_uuid",
      pipeline_run_id = "pipeline_run_id",
      step_name       = "step_name",
      content_id      = "content_id",
      asin            = "asin",
      review_queue_id = "review_queue_id",
    }
  }
}

loki.source.file "docker_json_logs" {
  targets = [
    {
      __path__ = "/var/lib/docker/containers/*/*.log",
      host     = sys.env("COMMON_HOST_LABEL"),
      stream   = "docker-json",
    },
  ]

  forward_to = [loki.write.grafana_cloud.receiver]

  file_match {
    enabled     = true
    sync_period = "30s"
  }
}

loki.source.file "system_logs" {
  targets = [
    {
      __path__ = "/var/log/{syslog,messages,*.log}",
      host     = sys.env("COMMON_HOST_LABEL"),
      stream   = "system",
    },
  ]

  forward_to = [loki.write.grafana_cloud.receiver]

  file_match {
    enabled     = true
    sync_period = "30s"
  }
}

loki.write "grafana_cloud" {
  endpoint {
    url = sys.env("GCLOUD_HOSTED_LOGS_URL")

    basic_auth {
      username = sys.env("GCLOUD_HOSTED_LOGS_ID")
      password = sys.env("GCLOUD_RW_API_KEY")
    }
  }
}
