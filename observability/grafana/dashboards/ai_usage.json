{
  "uid": "dp-ai-usage",
  "title": "Deal pipeline: AI usage and cost",
  "description": "LLM calls recorded by amazonnew and reviewgate (llm_usage_events), budget top-ups, and provider balance checks. Replaces the dashboard app's Usage page.",
  "tags": [
    "deal-pipeline"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "5m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "MySQL",
        "type": "datasource",
        "query": "mysql",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Cost",
      "description": "",
      "datasource": {
        "type": "mysql",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${ds}"
          },
          "rawSql": "SELECT COALESCE(SUM(response_cost_usd),0) AS cost FROM dealstage_db.llm_usage_events WHERE $__timeFilter(request_started_at)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Calls",
      "description": "",
      "datasource": {
        "type": "mysql",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${ds}"
          },
          "rawSql": "SELECT COUNT(*) AS calls FROM dealstage_db.llm_usage_events WHERE $__timeFilter(request_started_at)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "id": 2,
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Tokens",
      "description": "",
      "datasource": {
        "type": "mysql",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${ds}"
          },
          "rawSql": "SELECT COALESCE(SUM(total_tokens),0) AS tokens FROM dealstage_db.llm_usage_events WHERE $__timeFilter(request_started_at)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "id": 3,
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Failed calls",
      "description": "",
      "datasource": {
        "type": "mysql",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${ds}"
          },
          "rawSql": "SELECT COUNT(*) AS calls FROM dealstage_db.llm_usage_events WHERE $__timeFilter(request_started_at) AND call_status NOT IN ('SUCCEEDED','SUCCESS')",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Budget left (all time)",
      "description": "Top-ups recorded with amazonnew/jobs/add_budget.sh minus all recorded LLM cost. Only as accurate as the recorded top-ups.",
      "datasource": {
        "type": "mysql",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${ds}"
          },
          "rawSql": "SELECT (SELECT COALESCE(SUM(amount_usd),0) FROM dealstage_db.llm_budget_deposits) - (SELECT COALESCE(SUM(response_cost_usd),0) FROM dealstage_db.llm_usage_events) AS remaining",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "id": 5,
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Avg latency",
      "description": "",
      "datasource": {
        "type": "mysql",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${ds}"
          },
          "rawSql": "SELECT AVG(latency_ms) AS latency FROM dealstage_db.llm_usage_events WHERE $__timeFilter(request_started_at)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "id": 6,
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "timeseries",
      "title": "Cost per day by model",
      "description": "",
      "datasource": {
        "type": "mysql",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${ds}"
          },
          "rawSql": "SELECT $__timeGroupAlias(request_started_at,'1d'), model_name AS metric, SUM(response_cost_usd) AS value FROM dealstage_db.llm_usage_events WHERE $__timeFilter(request_started_at) GROUP BY 1,2 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Tokens per day by stage",
      "description": "",
      "datasource": {
        "type": "mysql",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${ds}"
          },
          "rawSql": "SELECT $__timeGroupAlias(request_started_at,'1d'), stage_name AS metric, SUM(total_tokens) AS value FROM dealstage_db.llm_usage_events WHERE $__timeFilter(request_started_at) GROUP BY 1,2 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "id": 8,
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "table",
      "title": "By provider and model",
      "description": "",
      "datasource": {
        "type": "mysql",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${ds}"
          },
          "rawSql": "SELECT provider_name, model_name, COUNT(*) AS calls, SUM(total_tokens) AS tokens, ROUND(SUM(response_cost_usd),4) AS cost_usd, ROUND(AVG(latency_ms)) AS avg_latency_ms, SUM(call_status NOT IN ('SUCCEEDED','SUCCESS')) AS failed FROM dealstage_db.llm_usage_events WHERE $__timeFilter(request_started_at) GROUP BY provider_name, model_name ORDER BY cost_usd DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "table",
      "title": "Provider balance checks (latest per provider)",
      "description": "Written daily at 06:00 by common's api-balance-check step; empty until its settings are complete.",
      "datasource": {
        "type": "mysql",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${ds}"
          },
          "rawSql": "SELECT b.provider, b.checked_at, b.configured, b.auth_ok, b.balance_usd, b.alert_threshold_usd, LEFT(b.balance_message, 100) AS message FROM telemetry_db.api_balance_check b JOIN (SELECT provider, MAX(checked_at) AS checked_at FROM telemetry_db.api_balance_check GROUP BY provider) l ON l.provider = b.provider AND l.checked_at = b.checked_at ORDER BY b.provider",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "id": 10,
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "table",
      "title": "Budget top-ups",
      "description": "",
      "datasource": {
        "type": "mysql",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${ds}"
          },
          "rawSql": "SELECT created_at, provider_name, amount_usd, added_by, note FROM dealstage_db.llm_budget_deposits ORDER BY created_at DESC LIMIT 30",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "id": 11,
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 7
      }
    }
  ]
}