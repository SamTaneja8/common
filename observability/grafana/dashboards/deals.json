{
  "uid": "dp-deals",
  "title": "Deal pipeline: deals and review",
  "description": "Amazon page scans, the review queue, AI runs and publishing. Replaces the dashboard app's Overview, Pipeline and Review queue pages.",
  "tags": [
    "deal-pipeline"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "MySQL",
        "type": "datasource",
        "query": "mysql",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Pending review",
      "description": "",
      "datasource": {
        "type": "mysql",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${ds}"
          },
          "rawSql": "SELECT COUNT(*) AS items FROM dealstage_db.amzn_review_queue WHERE review_status IN ('PENDING_REVIEW','READY_REVIEW')",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Needs rework",
      "description": "",
      "datasource": {
        "type": "mysql",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${ds}"
          },
          "rawSql": "SELECT COUNT(*) AS items FROM dealstage_db.amzn_review_queue WHERE review_status = 'NEEDS_REWORK'",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "id": 2,
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Published",
      "description": "",
      "datasource": {
        "type": "mysql",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${ds}"
          },
          "rawSql": "SELECT COUNT(*) AS items FROM dealstage_db.amzn_review_queue WHERE $__timeFilter(published_at)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "id": 3,
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Page scans OK",
      "description": "",
      "datasource": {
        "type": "mysql",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${ds}"
          },
          "rawSql": "SELECT COUNT(*) AS scans FROM dealstage_db.amzn_affiliate_page_scans WHERE $__timeFilter(scanned_at) AND fetch_status = 'SUCCESS'",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Page scans failed",
      "description": "",
      "datasource": {
        "type": "mysql",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${ds}"
          },
          "rawSql": "SELECT COUNT(*) AS scans FROM dealstage_db.amzn_affiliate_page_scans WHERE $__timeFilter(scanned_at) AND fetch_status <> 'SUCCESS'",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "id": 5,
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "AI tasks failed",
      "description": "",
      "datasource": {
        "type": "mysql",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${ds}"
          },
          "rawSql": "SELECT COUNT(*) AS tasks FROM dealstage_db.amzn_ai_tasks WHERE $__timeFilter(created_at) AND task_status = 'FAILED'",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "id": 6,
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "barchart",
      "title": "Review queue by status (now)",
      "description": "",
      "datasource": {
        "type": "mysql",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${ds}"
          },
          "rawSql": "SELECT review_status AS status, COUNT(*) AS items FROM dealstage_db.amzn_review_queue GROUP BY review_status ORDER BY items DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "showValue": "always",
        "xTickLabelRotation": 0
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Page scans per day by result",
      "description": "",
      "datasource": {
        "type": "mysql",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${ds}"
          },
          "rawSql": "SELECT $__timeGroupAlias(scanned_at,'1d'), COALESCE(NULLIF(error_code,''), fetch_status) AS metric, COUNT(*) AS value FROM dealstage_db.amzn_affiliate_page_scans WHERE $__timeFilter(scanned_at) GROUP BY 1,2 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "id": 8,
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 16,
        "h": 8
      }
    },
    {
      "type": "table",
      "title": "Latest AI runs",
      "description": "",
      "datasource": {
        "type": "mysql",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${ds}"
          },
          "rawSql": "SELECT started_at, finished_at, status, source_rows, enriched_rows, error_rows, model_name, LEFT(error_message, 120) AS error FROM dealstage_db.amzn_ai_runs WHERE $__timeFilter(started_at) ORDER BY started_at DESC LIMIT 30",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "table",
      "title": "Latest page-scan runs",
      "description": "",
      "datasource": {
        "type": "mysql",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${ds}"
          },
          "rawSql": "SELECT started_at, finished_at, status, source_rows, scanned_rows, success_rows, error_rows, proxy_provider FROM dealstage_db.amzn_page_runs WHERE $__timeFilter(started_at) ORDER BY started_at DESC LIMIT 30",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "id": 10,
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "table",
      "title": "Publish log",
      "description": "",
      "datasource": {
        "type": "mysql",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${ds}"
          },
          "rawSql": "SELECT created_at, review_queue_id, publish_status, dealvant_target_table, dealvant_target_id, LEFT(publish_error, 160) AS error FROM dealstage_db.amzn_publish_log WHERE $__timeFilter(created_at) ORDER BY created_at DESC LIMIT 50",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "id": 11,
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "table",
      "title": "Failed AI tasks",
      "description": "",
      "datasource": {
        "type": "mysql",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${ds}"
          },
          "rawSql": "SELECT created_at, review_queue_id, stage_name, model_name, attempt_count, LEFT(error_message, 160) AS error FROM dealstage_db.amzn_ai_tasks WHERE $__timeFilter(created_at) AND task_status = 'FAILED' ORDER BY created_at DESC LIMIT 50",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "id": 12,
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 9
      }
    }
  ]
}