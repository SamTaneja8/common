{
  "uid": "dp-operations",
  "title": "Deal pipeline: operations",
  "description": "Scheduled runs (orchestrator and jobs), failures, hangs, scraper intake and scraper health. Replaces the dashboard app's Operations page.",
  "tags": [
    "deal-pipeline"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "5m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "MySQL",
        "type": "datasource",
        "query": "mysql",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Pipeline runs",
      "description": "",
      "datasource": {
        "type": "mysql",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${ds}"
          },
          "rawSql": "SELECT COUNT(*) AS runs FROM telemetry_db.pipeline_run WHERE $__timeFilter(started_at)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Pipeline runs not SUCCESS",
      "description": "",
      "datasource": {
        "type": "mysql",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${ds}"
          },
          "rawSql": "SELECT COUNT(*) AS runs FROM telemetry_db.pipeline_run WHERE $__timeFilter(started_at) AND status <> 'SUCCESS' AND status <> 'RUNNING'",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "id": 2,
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Job runs",
      "description": "",
      "datasource": {
        "type": "mysql",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${ds}"
          },
          "rawSql": "SELECT COUNT(*) AS runs FROM telemetry_db.job_run_metering WHERE $__timeFilter(started_at)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "id": 3,
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Job runs failed",
      "description": "",
      "datasource": {
        "type": "mysql",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${ds}"
          },
          "rawSql": "SELECT COUNT(*) AS runs FROM telemetry_db.job_run_metering WHERE $__timeFilter(started_at) AND status IN ('FAILED','PARTIAL')",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Jobs running > 30 min",
      "description": "Hung or killed jobs: a job stopped by the orchestrator's step timeout can't record its own finish, so it stays RUNNING.",
      "datasource": {
        "type": "mysql",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${ds}"
          },
          "rawSql": "SELECT COUNT(*) AS jobs FROM telemetry_db.job_run_metering WHERE status = 'RUNNING' AND started_at < UTC_TIMESTAMP() - INTERVAL 30 MINUTE AND started_at > UTC_TIMESTAMP() - INTERVAL 2 DAY",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "id": 5,
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Deals inserted",
      "description": "",
      "datasource": {
        "type": "mysql",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${ds}"
          },
          "rawSql": "SELECT COALESCE(SUM(inserted),0) AS deals FROM telemetry_db.deals_ingest WHERE $__timeFilter(created_at)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "id": 6,
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "timeseries",
      "title": "Job runs per hour by status",
      "description": "",
      "datasource": {
        "type": "mysql",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${ds}"
          },
          "rawSql": "SELECT $__timeGroupAlias(started_at,'1h'), status AS metric, COUNT(*) AS value FROM telemetry_db.job_run_metering WHERE $__timeFilter(started_at) GROUP BY 1,2 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Average job duration by job",
      "description": "",
      "datasource": {
        "type": "mysql",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${ds}"
          },
          "rawSql": "SELECT $__timeGroupAlias(started_at,'2h'), job_name AS metric, AVG(duration_seconds) AS value FROM telemetry_db.job_run_metering WHERE $__timeFilter(started_at) AND duration_seconds IS NOT NULL GROUP BY 1,2 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "id": 8,
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "table",
      "title": "Latest job runs",
      "description": "",
      "datasource": {
        "type": "mysql",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${ds}"
          },
          "rawSql": "SELECT started_at, job_name, service_name, status, duration_seconds, exit_code, LEFT(detail_message, 160) AS detail FROM telemetry_db.job_run_metering WHERE $__timeFilter(started_at) ORDER BY started_at DESC LIMIT 100",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 9
      }
    },
    {
      "type": "table",
      "title": "Latest pipeline runs",
      "description": "",
      "datasource": {
        "type": "mysql",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${ds}"
          },
          "rawSql": "SELECT started_at, pipeline_name, status, total_steps, current_step_name, failed_step_name, duration_seconds, LEFT(error_summary, 160) AS error FROM telemetry_db.pipeline_run WHERE $__timeFilter(started_at) ORDER BY started_at DESC LIMIT 50",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "id": 10,
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Scraper intake per run window",
      "description": "",
      "datasource": {
        "type": "mysql",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${ds}"
          },
          "rawSql": "SELECT $__timeGroupAlias(created_at,'2h'), 'inserted' AS metric, SUM(inserted) AS value FROM telemetry_db.deals_ingest WHERE $__timeFilter(created_at) GROUP BY 1 UNION ALL SELECT $__timeGroupAlias(created_at,'2h'), 'updated', SUM(updated) FROM telemetry_db.deals_ingest WHERE $__timeFilter(created_at) GROUP BY 1 UNION ALL SELECT $__timeGroupAlias(created_at,'2h'), 'errors', SUM(error_count) FROM telemetry_db.deals_ingest WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "id": 11,
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Proxy success rate by provider",
      "description": "",
      "datasource": {
        "type": "mysql",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${ds}"
          },
          "rawSql": "SELECT $__timeGroupAlias(attempted_at,'1h'), provider_name AS metric, 100 * AVG(success_flag) AS value FROM telemetry_db.proxy_attempt_events WHERE $__timeFilter(attempted_at) GROUP BY 1,2 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "id": 12,
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Playwright exceptions per hour by type",
      "description": "",
      "datasource": {
        "type": "mysql",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${ds}"
          },
          "rawSql": "SELECT $__timeGroupAlias(created_at,'1h'), error_type AS metric, COUNT(*) AS value FROM telemetry_db.playwright_exception_events WHERE $__timeFilter(created_at) GROUP BY 1,2 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "id": 13,
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "table",
      "title": "Latest Playwright exceptions",
      "description": "",
      "datasource": {
        "type": "mysql",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${ds}"
          },
          "rawSql": "SELECT created_at, repo_name, job_name, step_name, error_type, LEFT(error_message, 160) AS message, LEFT(target_url, 100) AS url FROM telemetry_db.playwright_exception_events WHERE $__timeFilter(created_at) ORDER BY created_at DESC LIMIT 50",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "id": 14,
      "gridPos": {
        "x": 12,
        "y": 37,
        "w": 12,
        "h": 9
      }
    }
  ]
}