EVOMI_USERNAME=
EVOMI_PASSWORD=
EVOMI_HOST=core-residential.evomi.com
EVOMI_PORT=1000
EVOMI_COUNTRY=us
# Used only by common_utils.proxy_balance_check (reseller balance lookup),
# separate from the proxy connection credentials above.
EVOMI_API_KEY=

BRIGHTDATA_USERNAME=
BRIGHTDATA_PASSWORD=
BRIGHTDATA_HOST=brd.superproxy.io
BRIGHTDATA_PORT=22225
BRIGHTDATA_COUNTRY=us

DECODO_USERNAME=
DECODO_PASSWORD=
DECODO_HOST=gate.decodo.com
DECODO_PORT=10001
DECODO_COUNTRY=us

FLOPPYDATA_USERNAME=
FLOPPYDATA_PASSWORD=
FLOPPYDATA_HOST=gate.floppydata.com
FLOPPYDATA_PORT=10000
FLOPPYDATA_COUNTRY=us
# FloppyData balance checking (common_utils.proxy_balance_check) is optional
# and uses a configurable API endpoint -- set the URL plus any required auth
# header/value if your FloppyData account supports it.
FLOPPYDATA_BALANCE_API_URL=
FLOPPYDATA_BALANCE_AUTH_HEADER=Authorization
FLOPPYDATA_BALANCE_AUTH_VALUE=

# common_utils.proxy_balance_check: which URL to hit through each proxy to
# confirm authorization, and the USD balance threshold that triggers a
# WARNING log line.
PROXY_CHECK_URL=http://httpbin.org/ip
PROXY_BALANCE_ALERT_USD=5

# common_utils.api_balance_check: authorization + balance checks for AI
# provider API keys, logged and persisted to telemetry_db.api_balance_check.
OPENAI_API_KEY=
OPENAI_BALANCE_API_URL=
OPENAI_BALANCE_AUTH_HEADER=Authorization
OPENAI_BALANCE_AUTH_VALUE=
OPENAI_BALANCE_ALERT_USD=5

HF_TOKEN=
HUGGINGFACE_BALANCE_API_URL=
HUGGINGFACE_BALANCE_AUTH_HEADER=Authorization
HUGGINGFACE_BALANCE_AUTH_VALUE=
HUGGINGFACE_BALANCE_ALERT_USD=5

DEEPSEEK_TOKEN=
DEEPSEEK_BALANCE_ALERT_USD=5

GEMINI_API_KEY=
GEMINI_BALANCE_API_URL=
GEMINI_BALANCE_AUTH_HEADER=Authorization
GEMINI_BALANCE_AUTH_VALUE=
GEMINI_BALANCE_ALERT_USD=5

# Grafana Cloud settings used by the shared Alloy config.
LOG_SAVE_DAYS=7
COMMON_HOST_LABEL=vps1

GCLOUD_HOSTED_METRICS_URL=https://prometheus-prod-66-prod-us-east-3.grafana.net/api/prom/push
GCLOUD_HOSTED_METRICS_ID=3327852
GCLOUD_SCRAPE_INTERVAL=60s

