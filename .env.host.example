# Host-only settings for scripts that run directly on the host, not in Docker:
# orchestration/run_pipeline.py and scripts/run_job_common.sh (the balance
# checks). Copy to .env.host (git-ignored). Containers never read this file,
# so host-only values like 127.0.0.1 here can't leak into them the way they
# would from .env, which several compose files also load.
#
# telemetry_db from the VPS1 host: MySQL is published on 127.0.0.1:53306
# (inside Docker it's unified-mysql:3306). Use a user that can INSERT/UPDATE
# telemetry_db; host connections arrive from the Docker bridge (172.x), so the
# user's grant must allow that host (e.g. '%' or '172.%').
TELEMETRY_MYSQL_HOST=127.0.0.1
TELEMETRY_MYSQL_PORT=53306
TELEMETRY_MYSQL_DATA=telemetry_db
TELEMETRY_MYSQL_USER=
TELEMETRY_MYSQL_PASS=

# Grafana Cloud API, for scripts/push_grafana_dashboards.sh (uploads
# observability/grafana/dashboards/*.json). A service account token with the
# Editor role: Administration -> Users and access -> Service accounts.
GRAFANA_URL=https://<stack>.grafana.net
GRAFANA_SA_TOKEN=

# telemetry_db backup (jobs/run_backup.sh, pipeline.yaml step telemetry-backup).
# Moved from the dashboard repo; the name stays "dashboard" (B2 folder and
# backup positions). Keep retention 0: runs are incremental.
BACKUP_REPO_NAME=dashboard
BACKUP_RETENTION=0
BACKUP_DATABASES_OF_INTEREST=telemetry_db
REPO_MYSQL_BACKUP_TABLE_SPECS=telemetry_db.job_run_metering:updated_at:datetime,telemetry_db.pipeline_run:updated_at:datetime,telemetry_db.deals_ingest:updated_at:datetime,telemetry_db.deals_redirect:updated_at:datetime,telemetry_db.playwright_exception_events:updated_at:datetime,telemetry_db.telemetry_pipeline_rollups:updated_at:datetime,telemetry_db.deal_correlation:updated_at:datetime,telemetry_db.pipeline_journey_events:id:numeric,telemetry_db.proxy_attempt_events:id:numeric,telemetry_db.api_balance_check:id:numeric
BACKUP_INCREMENTAL_TABLES=telemetry_db.job_run_metering:updated_at:datetime,telemetry_db.pipeline_run:updated_at:datetime,telemetry_db.deals_ingest:updated_at:datetime,telemetry_db.deals_redirect:updated_at:datetime,telemetry_db.playwright_exception_events:updated_at:datetime,telemetry_db.telemetry_pipeline_rollups:updated_at:datetime,telemetry_db.deal_correlation:updated_at:datetime,telemetry_db.pipeline_journey_events:id:numeric,telemetry_db.proxy_attempt_events:id:numeric,telemetry_db.api_balance_check:id:numeric
