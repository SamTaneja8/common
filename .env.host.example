# Host-only settings for scripts that run directly on the host, not in Docker:
# orchestration/run_pipeline.py and scripts/run_job_common.sh (the balance
# checks). Copy to .env.host (git-ignored). Containers never read this file,
# so host-only values like 127.0.0.1 here can't leak into them the way they
# would from .env, which several compose files also load.
#
# telemetry_db from the VPS1 host: MySQL is published on 127.0.0.1:53306
# (inside Docker it's unified-mysql:3306). Use a user that can INSERT/UPDATE
# telemetry_db; host connections arrive from the Docker bridge (172.x), so the
# user's grant must allow that host (e.g. '%' or '172.%').
TELEMETRY_MYSQL_HOST=127.0.0.1
TELEMETRY_MYSQL_PORT=53306
TELEMETRY_MYSQL_DATA=telemetry_db
TELEMETRY_MYSQL_USER=
TELEMETRY_MYSQL_PASS=
