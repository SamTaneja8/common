FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

WORKDIR /var/www/app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl \
        fonts-liberation \
        fonts-dejavu-core \
        fonts-noto-core \
        fonts-noto-color-emoji \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --upgrade pip setuptools wheel \
    && python -m pip install --no-cache-dir \
        beautifulsoup4==4.13.4 \
        httpx \
        mysql-connector-python \
        playwright==1.54.0 \
        playwright-stealth==2.0.0 \
        pydantic \
        python-dotenv==1.1.0 \
        requests

RUN python -m playwright install --with-deps chromium \
    && python -c "from playwright.sync_api import sync_playwright; p = sync_playwright().start(); browser = p.chromium.launch(headless=True); page = browser.new_page(); page.goto('data:text/html,<title>ok</title><h1>ok</h1>'); assert page.title() == 'ok'; browser.close(); p.stop()" \
    && rm -rf /var/lib/apt/lists/*

# Record the Chromium build actually bundled above so
# common_utils.stealth.context_builder.bundled_chromium_major_version() can
# build honest User-Agent strings at runtime instead of a hand-maintained
# guess. Built once here (rather than duplicated per consuming repo) since
# both dealnews1 and dealmoon1 pull from this same image and would report
# the identical real version anyway.
RUN python -c "from playwright.sync_api import sync_playwright; p = sync_playwright().start(); b = p.chromium.launch(); open('/etc/chromium_version', 'w').write(b.version); b.close(); p.stop()"

COPY . /tmp/common
RUN python -m pip install --no-cache-dir /tmp/common \
    && install -m 0755 /tmp/common/scripts/run_job_common.sh /usr/local/bin/run_job_common.sh \
    && install -m 0755 /tmp/common/bin/metering_cli.py /usr/local/bin/metering_cli.py \
    && rm -rf /tmp/common

# Also copy the shared source tree directly so scraper repos always get the
# full module set even if wheel packaging lags behind new subpackages.
COPY common_utils /usr/local/lib/python3.11/site-packages/common_utils

RUN mkdir -p /var/www/app/logs /var/www/app/artifacts

CMD ["python", "--version"]
